<Window x:Class="GhostPin.Windows.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="GhostPin 设置"
        Width="480" Height="540" MinWidth="480" MinHeight="540" MaxWidth="480" MaxHeight="540"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#FFF3F3F3" Foreground="#FF20231F"
        PreviewKeyDown="OnPreviewKeyDown"
        Icon="/GhostPin.Windows.App;component/Assets/GhostPinLogo.png">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#FFC47B16" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FF20231F" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FF697069" />
        <Style x:Key="SettingCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="BorderBrush" Value="#FFE0E4DE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SettingHint" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="StepperButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="#FFF7F8F6" />
            <Setter Property="BorderBrush" Value="#FFD5DAD3" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="TabItemStyle" TargetType="TabItem">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="18,7" />
        </Style>
    </Window.Resources>

    <Grid Margin="22,18,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Width="44" Height="44" Source="/GhostPin.Windows.App;component/Assets/GhostPinLogo.png" Stretch="Uniform" />
            <StackPanel Grid.Column="1" Margin="12,1,0,0">
                <TextBlock Text="GhostPin 设置" FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                <TextBlock Text="调整幽灵 HUD 与交互方式" Style="{StaticResource SettingHint}" Margin="0,3,0,0" />
            </StackPanel>
        </Grid>

        <TabControl x:Name="SettingsTabs" Grid.Row="1" Background="Transparent" BorderBrush="#FFD9DDD7"
                    SelectionChanged="OnSettingsTabChanged">
            <TabItem Header="HUD" Style="{StaticResource TabItemStyle}">
                <StackPanel Margin="12,14,12,8">
                    <Border Style="{StaticResource SettingCard}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="透明度" Style="{StaticResource SettingLabel}" />
                                <TextBlock x:Name="OpacityValueText" Grid.Column="1" Foreground="{StaticResource AccentBrush}"
                                           FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                            </Grid>
                            <Slider x:Name="OpacitySlider" Grid.Row="1" Minimum="0.5" Maximum="1.0" TickFrequency="0.01"
                                    Margin="0,10,0,0" automation:AutomationProperties.Name="HUD 透明度" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingCard}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="显示范围" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="选择全部未完成或今天新增" Style="{StaticResource SettingHint}" Margin="0,3,12,0" />
                            </StackPanel>
                            <ComboBox x:Name="ScopeComboBox" Grid.Column="1" Height="30" VerticalContentAlignment="Center"
                                      automation:AutomationProperties.Name="HUD 显示范围">
                                <ComboBoxItem Content="全部未完成" /><ComboBoxItem Content="今天新增" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingCard}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="最多显示" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="Doing 任务优先占用条数" Style="{StaticResource SettingHint}" Margin="0,3,12,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="DecreaseMaxItemsButton" Content="−" Style="{StaticResource StepperButton}"
                                        automation:AutomationProperties.Name="减少显示条数" />
                                <TextBlock x:Name="MaxItemsValueText" Width="44" TextAlignment="Center" VerticalAlignment="Center"
                                           FontFamily="Cascadia Mono, Consolas" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" />
                                <Button x:Name="IncreaseMaxItemsButton" Content="+" Style="{StaticResource StepperButton}"
                                        automation:AutomationProperties.Name="增加显示条数" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingCard}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="HUD 置顶" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="保持在普通应用窗口上方" Style="{StaticResource SettingHint}" Margin="0,3,12,0" />
                            </StackPanel>
                            <CheckBox x:Name="TopmostCheckBox" Grid.Column="1" VerticalAlignment="Center"
                                      automation:AutomationProperties.Name="HUD 置顶" />
                        </Grid>
                    </Border>
                </StackPanel>
            </TabItem>

            <TabItem Header="高级" Style="{StaticResource TabItemStyle}">
                <StackPanel Margin="12,14,12,8">
                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="启用全局快捷键" Style="{StaticResource SettingLabel}" />
                                    <TextBlock Text="切换 HUD 的穿透与交互模式" Style="{StaticResource SettingHint}" Margin="0,3,12,0" />
                                </StackPanel>
                                <CheckBox x:Name="HotKeyEnabledCheckBox" Grid.Column="1" VerticalAlignment="Center"
                                          automation:AutomationProperties.Name="启用全局快捷键" />
                            </Grid>

                            <Border Margin="0,16,0,0" Padding="12" CornerRadius="9" Background="#FFF7F8F6"
                                    BorderBrush="#FFDDE1DB" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="当前快捷键" Style="{StaticResource SettingHint}" />
                                        <TextBlock x:Name="HotKeyValueText" Text="未设置" Margin="0,3,0,0"
                                                   FontFamily="Cascadia Mono, Consolas" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryTextBrush}" />
                                    </StackPanel>
                                    <Button x:Name="RecordHotKeyButton" Grid.Column="1" Content="录制快捷键" Padding="12,6"
                                            Margin="12,0,0,0" VerticalAlignment="Center"
                                            automation:AutomationProperties.Name="录制全局快捷键" />
                                    <Button x:Name="ClearHotKeyButton" Grid.Column="2" Content="清除" Padding="10,6"
                                            Margin="8,0,0,0" VerticalAlignment="Center"
                                            automation:AutomationProperties.Name="清除全局快捷键" />
                                </Grid>
                            </Border>

                            <TextBlock x:Name="HotKeyStatusText" Style="{StaticResource SettingHint}"
                                       Margin="0,14,0,0" MinHeight="34" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2" Text="更改会立即应用并自动保存。" Style="{StaticResource SettingHint}"
                   HorizontalAlignment="Center" Margin="0,11,0,0" />
    </Grid>
</Window>
